# Microsoft Entra ID (Azure AD) - get from Azure Portal
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here

# Database
DATABASE_URL="file:./dev.db"

# Password-reset email (Resend). Without RESEND_API_KEY the reset flow still
# runs, but no mail leaves the server — in dev the link is printed to the
# console instead, and in production nobody can recover a password.
# EMAIL_FROM must be on a domain verified in Resend; unset, it falls back to
# Resend's onboarding sender, which only delivers to your own Resend account.
# EMAIL_REPLY_TO is optional: an address you actually read, so a reply to the
# noreply@ sender reaches you instead of bouncing. Leave it unset to omit the
# header. A Cloudflare Email Routing address forwarding to your own inbox works.
RESEND_API_KEY=
EMAIL_FROM="Leadora <noreply@yourdomain>"
EMAIL_REPLY_TO=
