generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  events        Event[]
  people        Person[]
  reflections   Reflection[]
  tasks         Task[]
  checkIns      DailyCheckIn[]
  plannerInk    PlannerInk[]
  userData      UserData[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  category      String   @default("Personal")
  role          String   @default("Student")
  outlookId     String?  @unique
  location      String?
  isLed         Boolean  @default(false)
  attended      Boolean  @default(true)
  actualMinutes Int?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions  Interaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Person {
  id              String   @id @default(cuid())
  name            String
  category        String
  email           String?
  phone           String?
  dateMet         DateTime?
  notes           String?
  prayerRequests  String?
  goals           String?
  tags            String?
  followUpDate    DateTime?
  lastContactDate DateTime?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions    Interaction[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Interaction {
  id        String   @id @default(cuid())
  type      String
  notes     String?
  date      DateTime @default(now())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  priority      String    @default("medium")
  status        String    @default("todo")
  role          String    @default("Student")
  hours         Float?
  recurrence    String?
  recurrenceEnd DateTime?
  parentTaskId  String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DailyCheckIn {
  id        String   @id @default(cuid())
  date      DateTime
  energy    Int
  stress    Int
  mood      Int
  sleep     Float?
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Handwritten ink strokes for one page of the /planner notebook. Strokes are
// stored as vector JSON (normalised 0..1 coordinates) so they re-render crisply
// at any zoom and stay small on the wire.
model PlannerInk {
  id        String   @id @default(cuid())
  plannerId String   @default("collanote-2026") // which notebook (public/planner/<id>)
  page      Int // 1-based planner page number
  strokes   String // JSON array of {tool,color,size,points:[[x,y,pressure],...]}
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, plannerId, page])
}

// Per-account documents that used to live only in the browser: sub-calendars,
// the class schedule, roles, the notebooks a user made, their page indexes,
// stickers and custom templates. Each row is one JSON document, so a device
// syncs by pulling a scope and pushing back what it changed.
//
// It's a key/value table on purpose. Nothing here is queried by its contents —
// the server only ever hands a document back to the client that owns it — and
// the shapes are versioned by the client code that reads them, so modelling
// each one as its own table would buy no integrity and cost a migration every
// time a field moves.
model UserData {
  id        String    @id @default(cuid())
  scope     String // "setting" | "notebook" | "pageIndex" | "sticker" | "template"
  key       String // sub-key within the scope: the setting name, or a notebook id
  value     String // JSON document
  // Soft delete: a device that has been offline has to learn a notebook was
  // deleted elsewhere. A hard delete would look identical to "never synced" and
  // the stale copy would be pushed straight back up.
  deletedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, scope, key])
  @@index([userId, scope])
}

model Reflection {
  id        String   @id @default(cuid())
  type      String
  date      DateTime
  content   String
  mood      Int?
  energy    Int?
  gratitude String?
  podId     String?  // which themed pod this reflection came from (e.g. "essentials")
  questions String?  // JSON array of { question, answer } pairs from the guided flow
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

